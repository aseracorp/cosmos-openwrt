#!/bin/bash
exec 3>&1 4>&2
trap 'exec 2>&4 1>&3' 0 1 2 3
exec 1> >(logger -s -t $(basename $0)) 2>&1
# Everything below will go to logread:

# Unified logging onto OpenWrt syslog (logread).
log() { logger -t CosmosCloud "$@"; }

init() {
        exec 1>init.plain.log 2>&1
        # Everything below will go to the file 'init.plain.log':

        # should the docker volumes be copy on write? This enables compression but accelerates writes onto disk which is harmful for the disk with f.e. database-files. You then need to disable it manually (for databases) on a subfolder basis with 'chattr +C <path-to-subfolder>'. !! Only applies to new files created !!
        # cow=true

        # env from the persistent cosmos dir, then any boot-partition override
        cd /etc/cosmos || exit 1
        [ -f ./.env ] && source ./.env
        [ -f /boot/.env ] && source /boot/.env
        touch init.conf
        touch /tmp/cosmos.log
        touch /tmp/cosmos.plain.log

        readdisk () {
        #read-out disk infos (sets globals root_partition, disk, new_part_id, new_part)
        local dev
        root_partition=$(basename "$(readlink -f "/sys/dev/block/$(awk -e '$9=="/dev/root"{print $3}' /proc/self/mountinfo)")")
        disk=$(lsblk --list --noheadings --paths --output PKNAME "/dev/${root_partition}" | sed "s@/dev/@@")
        if [[ "${disk}" =~ ^sd[a-z] ]]; then
                (( new_part_id = ${root_partition//${disk}/} + 1 ))
                new_part="${disk}${new_part_id}"
        else
                (( new_part_id = ${root_partition//${disk}p/} + 1 ))
                new_part="${disk}p${new_part_id}"
        fi
        }

        #add symlink for config
        while [ ! -L /var/lib/cosmos ]; do
                while [ -d /var/lib/cosmos ]; do rm -R /var/lib/cosmos && sleep 1; done
                ln -s /etc/cosmos/ /var/lib/cosmos
                log "var/lib/cosmos: create symlink to persist storage..."
                sleep 1
        done
        if [ ! -L cosmos.log  ]; then
        if [ -f cosmos.log  ]; then rm cosmos.log; fi
                ln -s /tmp/cosmos.log /etc/cosmos/cosmos.log
                log "cosmos.log: create symlink to tmp..."
        fi
        if [ ! -L cosmos.plain.log  ]; then
        if [ -f cosmos.plain.log  ]; then rm cosmos.plain.log; fi
                ln -s /tmp/cosmos.plain.log /etc/cosmos/cosmos.plain.log
                log "cosmos.plain.log: create symlink to tmp..."
        fi
        docker_tries=0
        while [ ! -L /var/lib/docker ] && [ "${docker_tries}" -lt 10 ]; do
                [ -d /var/lib/docker ] && rmdir /var/lib/docker
                ln -s /opt/docker/ /var/lib/docker
                log "var/lib/docker: create symlink to fix wrong docker links..."
                ((docker_tries++))
        done

        #only with btrfs storage: ensure the cosmos storage dir exists and add a
        #stable symlink to it (do nothing when STORAGE is false)
        if [ "$STORAGE" = true ]; then
                mkdir -p /opt/docker/cosmos
                if [ ! -L /cosmos-storage ]; then
                        [ -d /cosmos-storage ] && rmdir /cosmos-storage
                        ln -s /opt/docker/cosmos /cosmos-storage
                        log "cosmos-storage: create symlink to /opt/docker/cosmos..."
                fi
        fi

        #make sure dnsmasq is not blocking port 53 for constellation
        [ -n "$(uci get dhcp.@dnsmasq[0].notinterface 2>/dev/null | grep -o 'constellation')" ] || ( uci add_list dhcp.@dnsmasq[0].notinterface='constellation' && uci commit dhcp && service dnsmasq reload )
        [ -n "$(uci get dhcp.@dnsmasq[0].interface 2>/dev/null)" ] || ( uci show network | grep -oP '(?<=network.).*(?==interface)' | grep -v -P 'constellation|wan|wwan|tailscale|nebula' | xargs -r -I % sh -c "uci add_list dhcp.@dnsmasq[0].interface='%'" && uci commit dhcp && service dnsmasq reload )
        [ -z "$(uci get dhcp.@dnsmasq[0].interface 2>/dev/null | grep -o 'constellation')" ] || ( uci del_list dhcp.@dnsmasq[0].interface='constellation' && uci commit dhcp && service dnsmasq reload )

        #inital commissioning
        if [[ $(cat init.conf | cut -c 0-25) != "commissioned successfully" ]]; then
                log "start init..."

                if [ -f config.txt ]; then
                        cat config.txt > /boot/config.txt && rm config.txt
                        log "update config.txt..."
                fi

                #mount eMMC (btrfs) filesystem (used for cosmos)
                if [ "$STORAGE" = true ]; then

                        readdisk
                        start_sector=$(( $(cat /sys/block/${disk}/${root_partition}/start) + $(cat /sys/block/${disk}/${root_partition}/size) ))

                        if [ ! -e /dev/"${new_part}" ]; then
                        log "add 3rd partition (btrfs) on empty space (start-sector: ${start_sector})..."
                        # add & format storage partition (use all empty space after root partition)
                        echo "n
                        p
                        ${new_part_id}
                        ${start_sector}

                        w" | fdisk -W always /dev/"${disk}"
                        log "format 3rd partition (btrfs)..."
                        sleep 1
                        partx -u /dev/"${disk}"
                        mkfs.btrfs /dev/"${new_part}"
                        sleep 1
                        fi
                        if [[ $(findmnt /opt/docker/ -no SOURCE) != "/dev/${new_part}" ]]; then
                        partx -u /dev/"${disk}"
                        #stop docker service
                        service dockerd stop
                        # clear docker dir
                        sleep 1 && rm -R /opt/docker/*
                        # mount btrfs partition to docker dir
                        log "mount 3rd partition (btrfs)..."
                        block detect | uci import fstab
                        #get new part id
                        new_part_id=$(uci show fstab | grep "/mnt/${new_part}" | cut -c 14-14)
                        uci set fstab.@mount[${new_part_id}].target='/opt/docker'
                        uci set fstab.@mount[${new_part_id}].enabled='1'
                        uci set fstab.@mount[${new_part_id}].options='compress=zstd:10'
                        uci commit fstab
                        #set btrfs dockerd storage driver
                        log "switch docker storage driver to btrfs..."
                        partx -u /dev/"${disk}"
                        uci set dockerd.globals.storage_driver="btrfs"
                        uci commit dockerd
                        service dockerd start
                        fi
                        if [[ $(findmnt /opt/docker/ -no SOURCE) = "/dev/${new_part}" ]]; then
                        if [ -z ${cow+x} ]; then
                                log "disable copy on write on docker volumes..."
                                mkdir -p /opt/docker/volumes
                                chattr +C /opt/docker/volumes
                        elif [ "${cow}" = "1" ]; then
                                log "enable copy on write on docker volumes... (! Danger)"
                                mkdir -p /opt/docker/volumes
                                chattr -C /opt/docker/volumes
                        fi
                        log "partition successfully mounted, store state as commissioned in init.conf. Delete the file to check partition-setup again"
                        echo "commissioned successfully with btrfs-storage" > init.conf
                        else
                        log "failed to mount, reboot now and try again..."
                        reboot && exit 0 #reboot, because all other commands like partx -u... weren't reliable
                        fi
                else
                        log "init finished without btrfs-storage"
                        echo "commissioned successfully without btrfs-storage" > init.conf
                fi

                #enable mdns with reflector
                log "enable mdns with reflector..."
                sed -i 's/enable-reflector=no/enable-reflector=yes/g' /etc/avahi/avahi-daemon.conf
                service avahi-daemon restart

                # Configure WAN
                if [[ $(ip a | grep eth1:) ]]; then
                        uci set network.wan=interface
                        uci set network.wan.proto='dhcp'
                        [ "$(uci get "$(uci show network | grep -oP "network\.@device\[[0-9]\]\.(?=name='$(uci get network.lan.device)')")ports")" == "eth1" ] && uci set network.wan.device='eth0' || uci set network.wan.device='eth1'
                        uci set network.wan.multipath='off'
                        uci commit network && service network reload
                fi

                #add LTE-interface
                if [ -e /dev/cdc-wdm0 ]; then
                        log "found LTE-module, setup wwan interface..."
                        uci set network.wwan=interface
                        uci set network.wwan.proto='qmi'
                        uci set network.wwan.device='/dev/cdc-wdm0'
                        uci set network.wwan.auth='none'
                        uci set network.wwan.pdptype='ipv4'
                        uci set network.wwan.metric='40'

                        uci add_list firewall.@zone[1].network='wwan'

                        uci set mwan3.wwan=interface
                        uci set mwan3.wwan.initial_state='online'
                        uci set mwan3.wwan.family='ipv4'
                        uci add_list mwan3.wwan.track_ip='1.0.0.1'
                        uci add_list mwan3.wwan.track_ip='1.1.1.1'
                        uci add_list mwan3.wwan.track_ip='208.67.220.222'
                        uci add_list mwan3.wwan.track_ip='208.67.222.222'
                        uci set mwan3.wwan.track_method='ping'
                        uci set mwan3.wwan.reliability='2'
                        uci set mwan3.wwan.count='1'
                        uci set mwan3.wwan.size='56'
                        uci set mwan3.wwan.max_ttl='60'
                        uci set mwan3.wwan.timeout='4'
                        uci set mwan3.wwan.interval='10'
                        uci set mwan3.wwan.failure_interval='5'
                        uci set mwan3.wwan.recovery_interval='5'
                        uci set mwan3.wwan.down='5'
                        uci set mwan3.wwan.up='5'
                        uci set mwan3.wwan_m4_w1=member
                        uci set mwan3.wwan_m4_w1.interface='wwan'
                        uci set mwan3.wwan_m4_w1.metric='4'
                        uci set mwan3.wwan_m4_w1.weight='1'
                        uci add_list mwan3.balanced.use_member='wwan_m4_w1'
                        uci add_list mwan3.default.use_member='wwan_m4_w1'
                        uci set mwan3.wwan.enabled='1'
                        if [ "${SIM_APN}" ]; then uci set network.WWAN.apn="${SIM_APN}" ; else uci set network.WWAN.apn='internet'; fi
                        if [ "${SIM_PIN}" ]; then uci set network.LTE.pincode="${SIM_PIN}" ; fi
                        uci commit network && service network reload
                        uci commit mwan3
                        uci commit firewall
                else
                        log "no LTE-module found, continue..."
                fi

                #switch root terminal to bash
                if [ ! $(cat /etc/passwd | grep root:/bin/bash) ]; then
                        sed -i -e 's@root:/bin/ash@root:/bin/bash@g' /etc/passwd
                        log "switch root terminal to bash..."
                fi
                #add cosmos user (for terminal in cosmos)
                if [ ! $(cat /etc/passwd | grep cosmos) ]; then
                        echo "cosmos:x:1000:1000:cosmos:/opt/cosmos:/bin/bash" >> /etc/passwd
                        log "add cosmos user..."
                fi
                if [ ! $(cat /etc/sudoers | grep cosmos) ]; then
                        echo "cosmos ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers
                        log "add cosmos to pw-less root..."
                fi

                #if there is a backup-file in boot partition, restore backup
                BACKUP=$(ls /boot | grep backup-.*\.tar\.gz)
                if [ "${BACKUP}" ]; then
                        echo "found backup in boot-partition, restore backup..."
                        sysupgrade -r "/boot/${BACKUP}"
                fi

                #start cosmos
                cd /opt/cosmos
                ./start.sh &
                #wait for cosmos to be ready and then continue, timeout after 60s
                timeout 60 bash -c "tail -n 10 -F /etc/cosmos/cosmos.log | grep -s -m 1 -o 'Listening to HTTP'"
                
                log "last reboot to have a clean state..."
                reboot && exit 0
        
        fi

        hostname=$(yq '.HTTPConfig.Hostname' /etc/cosmos/cosmos.config.json -o x)

        #on change of hostname, do this:
        if [[ "${hostname}" != "null" && "${hostname}" != "${HOSTNAME}" ]]; then

                #setup luci behind cosmos (only if cosmos setup is complete)
                if [ "${HOSTNAME}" == "0.0.0.0" ] && [ "$(yq '.NewInstall' /etc/cosmos/cosmos.config.json -o x)" == "false" ]; then
                        log "disable luci login..."

                        #set root password
                        (echo "${PASSWD}"; sleep 1; echo "${PASSWD}") | passwd > /dev/null

                        #block direct access, uhttpd only serves localhost:8080 for the cosmos proxy
                        uci del uhttpd.main.listen_http
                        uci del uhttpd.main.listen_https
                        uci add_list uhttpd.main.listen_http='127.0.0.1:8080'
                        uci del uhttpd.main.redirect_https
                        uci commit uhttpd
                        service uhttpd restart

                        #disable luci login (idempotent helper, works for every theme incl. footstrap)
                        /bin/disable-luci-login "${PASSWD}" "https://${hostname}/cosmos-ui/"
                        #soft-restart ucode/luci (dispatcher.uc is ucode; no service restart needed,
                        #but a fresh request picks the change up)
                else
                        log "update logout-URL..."
                        #re-invoke idempotent helper so the logout URL follows the new hostname
                        /bin/disable-luci-login "${PASSWD}" "https://${hostname}/cosmos-ui/"
                fi

                localIp=$(ip -4 addr show "$(uci get network.lan.device)" | grep -oP "(?<=inet ).*(?=/)")

                #allow private address for cosmos FQDN
                fqdn=`echo "${hostname}" | grep -P '(?=^.{1,254}$)(^(?>(?!\d+\.)[a-zA-Z0-9_\-]{1,63}\.?)+(?:[a-zA-Z]{2,})$)'`
                if [[ -n "${fqdn}" ]]; then
                        #uci add_list dhcp.@dnsmasq[0].address='/${hostname}/${myip}'
                        #uci commit dhcp
                        uci set dhcp.@dnsmasq[0].localservice='0'
                        uci del_list dhcp.@dnsmasq[0].rebind_domain="${HOSTNAME}"
                        uci add_list dhcp.@dnsmasq[0].rebind_domain="${hostname}"
                        uci del_list dhcp.@dnsmasq[0].address="/${HOSTNAME}/${LOCALIP}"
                        uci add_list dhcp.@dnsmasq[0].address="/${hostname}/${localIp}"
                        uci commit dhcp
                        service dnsmasq restart
                        sleep 2

                        ip=$(nslookup ${hostname} | awk -F': ' 'NR==6 { print $2 } ')
                        re='^(0*(1?[0-9]{1,2}|2([0-4][0-9]|5[0-5]))\.){3}'
                        re+='0*(1?[0-9]{1,2}|2([0-4][0-9]|5[0-5]))$'
                        if [[ ! $ip =~ $re ]]; then
                        uci del_list dhcp.@dnsmasq[0].server="/${HOSTNAME}/1.1.1.1"
                        uci add_list dhcp.@dnsmasq[0].server="/${hostname}/1.1.1.1"
                        uci commit dhcp
                        service dnsmasq restart
                        fi
                fi

                #save new hostname
                sed -i -r "s@(HOSTNAME=).*@\1${hostname}@g" ./.env
                sed -i -r "s@(LOCALIP=).*@\1${localIp}@g" ./.env

                #add OpenWRT GUI as App
                log "add OpenWRT to GUI as App..."
                if [[ "${hostname}" == *".local" ]]; then
                        owrt_hostname="openwrt.local"
                elif [[ "${hostname}" =~ ^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$ ]]; then
                        owrt_hostname="${hostname}:4443"
                else
                        owrt_hostname="openwrt.${hostname}"
                fi

                owrt_hostname="${owrt_hostname}" yq -i 'with(.HTTPConfig.ProxyConfig.Routes; select(all_c(.Name != "OpenWrt")) | . += {
                        "Disabled": false,
                        "Name": "OpenWrt",
                        "Description": "OpenWrt Router-Management",
                        "UseHost": true,
                        "Host": "${owrt_hostname}",
                        "UsePathPrefix": false,
                        "PathPrefix": "",
                        "Timeout": 14400000,
                        "ThrottlePerMinute": 10000,
                        "CORSOrigin": "",
                        "StripPathPrefix": true,
                        "MaxBandwith": 0,
                        "AuthEnabled": true,
                        "AdminOnly": true,
                        "Target": "http://localhost:8080",
                        "SmartShield": {
                                "Enabled": true,
                                "PolicyStrictness": 0,
                                "PerUserTimeBudget": 0,
                                "PerUserRequestLimit": 0,
                                "PerUserByteLimit": 0,
                                "PerUserSimultaneous": 0,
                                "MaxGlobalSimultaneous": 0,
                                "PrivilegedGroups": 0
                        },
                        "Mode": "PROXY",
                        "BlockCommonBots": true,
                        "BlockAPIAbuse": false,
                        "AcceptInsecureHTTPSTarget": true,
                        "HideFromDashboard": false,
                        "DisableHeaderHardening": false,
                        "SpoofHostname": false,
                        "AddionalFilters": null,
                        "RestrictToConstellation": false,
                        "OverwriteHostHeader": "",
                        "WhitelistInboundIPs": [],
                        "Icon": "https://raw.githubusercontent.com/openwrt/branding/refs/heads/master/logo/openwrt_logo_blue_and_dark_blue.svg",
                        "TunnelVia": "",
                        "TunneledHost": "",
                        "ExtraHeaders": null
                        } ) | with(.HTTPConfig.ProxyConfig.Routes[]; select(.Name == "OpenWrt") | .Host = env(owrt_hostname))' /etc/cosmos/cosmos.config.json

        fi

}

#set LED's to normal mode, startup
cd /etc/cosmos
init

#start cosmos & set LED's to normal mode, normal operation
exec 1> >(logger -s -t $(basename $0)) 2>&1
cd /opt/cosmos
./start.sh